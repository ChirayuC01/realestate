generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Property {
  id          String          @id @default(uuid())
  title       String
  slug        String          @unique
  description String
  address     String?
  city        String?
  state       String?
  zip         String?
  country     String?
  type        String?
  status      String?
  price       Float?
  bedrooms    Int?
  bathrooms   Int?
  areaSqFt    Int?
  images      PropertyImage[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model PropertyImage {
  id         String   @id @default(uuid())
  url        String
  property   Property @relation(fields: [propertyId], references: [id])
  propertyId String
}

model TeamMember {
  id       String          @id @default(uuid())
  name     String
  role     String
  bio      String?
  photoUrl String?
  tags     TeamMemberTag[]
}

model TeamMemberTag {
  id           String     @id @default(uuid())
  name         String
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id])
  teamMemberId String
}

model Blog {
  id          String      @id @default(uuid())
  title       String
  author      String
  slug        String      @unique
  excerpt     String?
  content     String
  published   Boolean     @default(false)
  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  images      BlogImage[]
}

model BlogImage {
  id     String @id @default(uuid())
  url    String
  blog   Blog   @relation(fields: [blogId], references: [id])
  blogId String
}

model ContactMessage {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  message   String
  createdAt DateTime @default(now())
}
